
{
  "expo": {
    "name": "LadyGo",
    "slug": "guga",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ladygo",
    "description": "LadyGo — сервис комфортных поездок. Удобный заказ, подтверждение стоимости и связь с водителем.",
    "primaryColor": "#E85D91",
    "backgroundColor": "#FFF4F7",
    "android": {
      "package": "com.ladygo.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#FFF4F7"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LadyGo использует геолокацию для определения места подачи автомобиля и организации поездки."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "95ac82ec-010d-4770-9aba-9f52878e1b3b"
      }
    }
  }
}
