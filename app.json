{
  "expo": {
    "name": "LadyGo",
    "slug": "guga",
    "version": "6.9.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ladygo",
    "description": "LadyGo — заказ поездок, поиск ближайших водителей, GPS-сопровождение и поддержка.",
    "primaryColor": "#E84F87",
    "backgroundColor": "#E84F87",
    "icon": "./icon.png",
    "android": {
      "package": "com.ladygo.app",
      "versionCode": 52,
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#E84F87"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LadyGo использует геолокацию для подачи автомобиля, построения маршрута и сопровождения поездки.",
          "locationAlwaysAndWhenInUsePermission": "Когда водитель включает режим «На линии», LadyGo использует фоновую геолокацию для получения заказов поблизости и обновления местоположения пассажиру.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "LadyGo использует выбранные фотографии для карточки водителя и автомобиля.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-yandex-mapkit",
        {
          "apiKey": "8db386a3-aa8a-4527-a507-3ad5ab6fd77b",
          "locale": "ru_RU",
          "flavor": "full",
          "version": "4.42.0"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "95ac82ec-010d-4770-9aba-9f52878e1b3b"
      }
    }
  }
}
