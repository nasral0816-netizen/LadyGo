{
  "expo": {
    "name": "LadyGo",
    "slug": "guga",
    "version": "6.8.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ladygo",
    "description": "LadyGo — маршруты и расчёт стоимости, анкеты водителей, проверка заявок и поддержка.",
    "primaryColor": "#E85D91",
    "backgroundColor": "#E65B8A",
    "icon": "./icon.png",
    "android": {
      "package": "com.ladygo.app",
      "versionCode": 50,
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#E80B87"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LadyGo использует геолокацию только для определения текущего местоположения при построении маршрута."
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "LadyGo использует выбранные фотографии для карточки водителя и автомобиля.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-yandex-mapkit",
        {
          "apiKey": "8db386a3-aa8a-4527-a507-3ad5ab6fd77b",
          "locale": "ru_RU",
          "flavor": "full",
          "version": "4.42.0"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "95ac82ec-010d-4770-9aba-9f52878e1b3b"
      }
    }
  }
}
